PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5173,https://bhanpura-csc.vercel.app
DB_PATH=./data/csc.db
# Email notifications (optional; if missing, messages still save to DB)
# Brevo (formerly Sendinblue) — get API key from https://www.brevo.com
BREVO_API_KEY=
# Email notification destination
NOTIFY_TO=digitalbhanpura@gmail.com
# Sender address shown in emails (must be a verified sender in your Brevo account)
FROM_EMAIL=noreply@bhanpura-csc.vercel.app
FROM_NAME=Bhanpura CSC Website
# Optional SMTP fallback (used only if Brevo is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
