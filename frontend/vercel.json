{
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/(favicon.svg|og-image.jpg|og-image.png|chatbot-icon.png|chatbot.png|csc-certificate.jpg|csc-id-card.jpg|hero-banner.webp)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
